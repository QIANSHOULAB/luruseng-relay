{
  // 录入僧 · 手机传图中转站。Cloudflare 从 GitHub 拉这个仓库自己部署：改了代码推上来就自动更新。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luruseng-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "QUOTA", "class_name": "Quota" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Quota"] }],
  "vars": { "ALLOW_ORIGINS": "https://qianshoulab.github.io", "COUNT_IP_MAX": "40", "COUNT_ALL_MAX": "400" },   // 铁件点钞机免钥匙额度：每个 IP 每天 40 次，所有人每天 400 次
  // 谷歌钥匙是 Secret：GEMINI_KEY（备胎 GEMINI_KEY2），在 Cloudflare 后台 Settings → Variables and Secrets 里加，不写在这里
  "workers_dev": true,                  // 地址：https://luruseng-relay.lunzigeju.workers.dev
  "preview_urls": false,                // 不要额外的预览地址
  "observability": { "enabled": false }
}
