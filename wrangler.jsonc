{
  // 录入僧 · 手机传图中转站。Cloudflare 从 GitHub 拉这个仓库自己部署：改了代码推上来就自动更新。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luruseng-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // BOX：一叶笺 ⇄ 大管家 信箱（/dgj，065）；LURU：录入僧 ⇄ 大管家 认照片（/lr，089）
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "QUOTA", "class_name": "Quota" }, { "name": "BOX", "class_name": "Box" }, { "name": "LURU", "class_name": "Luru" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Quota"] }, { "tag": "v3", "new_sqlite_classes": ["Box"] }, { "tag": "v4", "new_sqlite_classes": ["Luru"] }],
  "vars": { "ALLOW_ORIGINS": "https://qianshoulab.github.io", "COUNT_IP_MAX": "60", "COUNT_ALL_MAX": "600" },   // 铁件点钞机免钥匙额度（按请求算，一张照片两次：数一遍 + 复查一遍）：每个 IP 每天 60 次，所有人每天 600 次
  // 谷歌钥匙是 Secret：GEMINI_KEY（备胎 GEMINI_KEY2），在 Cloudflare 后台 Settings → Variables and Secrets 里加，不写在这里
  "workers_dev": true,                  // 地址：https://luruseng-relay.lunzigeju.workers.dev
  "preview_urls": false,                // 不要额外的预览地址
  "observability": { "enabled": false }
}
